rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════
    // SECURITY HELPERS
    // ══════════════════════════════════════════════════════════════════

    // User must be signed in via Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Google sign-in tokens are always email_verified for @gmail.com accounts.
    // For other OAuth providers the flag may differ — we allow any authenticated
    // Google sign-in, but still require the request to be authenticated.
    function isAuthenticated() {
      return isSignedIn();
    }

    // The requesting user owns this users/{uid} sub-tree
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Validate string: non-empty, within max length
    function validStr(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Validate optional string: if present, must be within max length
    function validOptStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function validDateOrNull(data, field) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validDeletedAt(data) {
      return !('deletedAt' in data)
        || data.deletedAt == null
        || (
          data.deletedAt is string
          && data.deletedAt.size() <= 40
          && data.deletedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$')
        );
    }

    function hasOnlyFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // ══════════════════════════════════════════════════════════════════
    // DENY EVERYTHING BY DEFAULT
    // Any path not explicitly matched below is DENIED automatically.
    // ══════════════════════════════════════════════════════════════════

    // ── PROFILES ─────────────────────────────────────────────────────
    // Each advocate has a profile document. Only they can read/write it.
    match /profiles/{uid} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && hasOnlyFields(request.resource.data, ['displayName', 'email', 'photoURL', 'updatedAt'])
        && validStr(request.resource.data.displayName, 100)
        && validStr(request.resource.data.email, 200)
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && validOptStr(request.resource.data, 'photoURL', 1000)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ── USER-SCOPED CASES & HEARINGS ─────────────────────────────────
    // Data model: users/{uid}/cases/{caseId}/hearings/{hId}
    // Case data is private to the signed-in owner of each user tree.

    match /users/{uid} {
      // The user document itself is not used directly
      allow read, write: if false;

      // ── CASES ────────────────────────────────────────────────────
      match /cases/{caseId} {

        // Only the owner can read their own cases
        allow read: if isOwner(uid);

        // Create a new case with validated required fields
        allow create: if isOwner(uid)
          && hasOnlyFields(request.resource.data, [
            'clientName', 'caseNumber', 'court', 'status', 'nextHearingDate',
            'ownerId', 'members', 'memberIds', 'createdAt', 'updatedAt', 'deletedAt',
            'clientPhone', 'caseType', 'oppositeParty', 'cnrNumber', 'stage', 'notes'
          ])
          // Required fields — type and length validation
          && validStr(request.resource.data.clientName, 200)
          && validStr(request.resource.data.caseNumber, 100)
          && validStr(request.resource.data.court, 200)
          && request.resource.data.status in ['Active', 'Closed']
          && request.resource.data.deletedAt == null
          // ownerId must match the authenticated user
          && request.resource.data.ownerId == uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // Members must be empty on creation
          && request.resource.data.members == {}
          && request.resource.data.memberIds == []
          // Optional fields — validated if present
          && validOptStr(request.resource.data, 'clientPhone', 20)
          && validOptStr(request.resource.data, 'caseType', 100)
          && validOptStr(request.resource.data, 'oppositeParty', 200)
          && validOptStr(request.resource.data, 'cnrNumber', 50)
          && validOptStr(request.resource.data, 'stage', 100)
          && validOptStr(request.resource.data, 'notes', 5000)
          && validDateOrNull(request.resource.data, 'nextHearingDate');

        // Update a case — owner can change anything except ownership
        allow update: if isOwner(uid)
          && hasOnlyFields(request.resource.data, [
            'clientName', 'caseNumber', 'court', 'status', 'nextHearingDate',
            'ownerId', 'members', 'memberIds', 'createdAt', 'updatedAt', 'deletedAt',
            'clientPhone', 'caseType', 'oppositeParty', 'cnrNumber', 'stage', 'notes'
          ])
          && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['ownerId', 'members', 'memberIds', 'createdAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clientName', 'caseNumber', 'court', 'status', 'nextHearingDate',
            'updatedAt', 'deletedAt', 'clientPhone', 'caseType', 'oppositeParty',
            'cnrNumber', 'stage', 'notes'
          ])
          && request.resource.data.updatedAt == request.time
          // Validate required fields remain valid on update too
          && validStr(request.resource.data.clientName, 200)
          && validStr(request.resource.data.caseNumber, 100)
          && validStr(request.resource.data.court, 200)
            && request.resource.data.status in ['Active', 'Closed']
            && validOptStr(request.resource.data, 'clientPhone', 20)
            && validOptStr(request.resource.data, 'caseType', 100)
            && validOptStr(request.resource.data, 'oppositeParty', 200)
            && validOptStr(request.resource.data, 'cnrNumber', 50)
            && validOptStr(request.resource.data, 'stage', 100)
            && validOptStr(request.resource.data, 'notes', 5000)
            && validDateOrNull(request.resource.data, 'nextHearingDate')
            && validDeletedAt(request.resource.data);

        // Hard delete is disabled — use soft delete (set deletedAt)
        allow delete: if false;

        // ── HEARINGS (subcollection) ──────────────────────────────
        match /hearings/{hId} {

          // Only the owner of the parent user tree can access hearings
          allow read: if isOwner(uid);

          // Create a hearing with a valid date
          allow create: if isOwner(uid)
            && hasOnlyFields(request.resource.data, [
              'caseId', 'date', 'time', 'notes', 'result', 'completed', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.caseId == caseId
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && validStr(request.resource.data.date, 10)
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.completed == false
            && validOptStr(request.resource.data, 'time', 20)
            && validOptStr(request.resource.data, 'notes', 2000)
            && validOptStr(request.resource.data, 'result', 500);

          // Update a hearing
          allow update: if isOwner(uid)
            && hasOnlyFields(request.resource.data, [
              'caseId', 'date', 'time', 'notes', 'result', 'completed', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.caseId == resource.data.caseId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && validStr(request.resource.data.date, 10)
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.completed is bool
            && validOptStr(request.resource.data, 'time', 20)
            && validOptStr(request.resource.data, 'notes', 2000)
            && validOptStr(request.resource.data, 'result', 500);

          // Hard delete is allowed for hearings (removing a hearing is expected)
          allow delete: if isOwner(uid);
        }
      }
    }

    // ── SERVER-ONLY COLLECTIONS ───────────────────────────────────────
    match /invites/{documentId} {
      allow read, write: if false;
    }

    match /auditLog/{logId} {
      allow read, write: if false;
    }

    match /inviteLimits/{documentId} {
      allow read, write: if false;
    }
  }
}
